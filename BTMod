-- Tên Script: BTMod
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BTMod" 
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

-- Tạo nút bấm
local Button = Instance.new("TextButton")
Button.Name = "BTModButton"
Button.Size = UDim2.new(0, 200, 0, 50)
Button.Position = UDim2.new(0.5, -100, 0.1, 0)
Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0) 
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 13
Button.Text = "Xóa con đang cảnh chừng trứng"
Button.Parent = ScreenGui

local isActive = false

Button.MouseButton1Click:Connect(function()
    isActive = not isActive
    
    if isActive then
        Button.Text = "HIỆN LẠI PET"
        Button.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                
                -- Kiểm tra xem có phải là nhân vật người chơi không
                local isCharacter = false
                for _, player in pairs(game.Players:GetPlayers()) do
                    if player.Character == v then
                        isCharacter = true
                        break
                    end
                end
                
                if not isCharacter then
                    v:SetAttribute("HiddenByScript", true)
                    
                    -- Vô hiệu hóa AI (Tắt não của pet)
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                        humanoid.PlatformStand = true -- Làm chúng đứng im như tượng
                    end
                    
                    -- Ngắt mọi liên kết vật lý (không thể cử động)
                    if v.PrimaryPart then 
                        v.PrimaryPart.Anchored = true
                        for _, joint in pairs(v.PrimaryPart:GetJoints()) do
                            joint:Destroy()
                        end
                    end
                    
                    -- Tắt va chạm và tương tác vật lý
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 1
                            part.CanCollide = false
                            part.CanTouch = false
                            part.CanQuery = false
                            part.Anchored = true
                        end
                        if part:IsA("Decal") then part.Transparency = 1 end
                    end
                    
                    -- Vô hiệu hóa các script điều khiển của Server (Nếu có)
                    for _, script in pairs(v:GetDescendants()) do
                        if script:IsA("Script") or script:IsA("LocalScript") then
                            script.Disabled = true
                        end
                    end
                    
                    -- Đưa chúng ra xa khỏi khu vực của bạn (để không thể đánh bạn)
                    v:PivotTo(CFrame.new(0, -500, 0)) 
                end
            end
        end
        
    else
        Button.Text = "Xóa con đang cảnh chừng trứng"
        Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
        
        -- Khôi phục lại pet (Nếu muốn)
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                if v:GetAttribute("HiddenByScript") then
                    -- Bật lại AI
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 16
                        humanoid.JumpPower = 50
                        humanoid.PlatformStand = false
                    end
                    
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 0
                            part.CanCollide = true
                            part.CanTouch = true
                            part.CanQuery = true
                            part.Anchored = false
                        end
                        if part:IsA("Decal") then part.Transparency = 0 end
                    end
                    -- Đưa chúng về lại chỗ cũ
                    v:PivotTo(CFrame.new(0, 10, 0))
                end
            end
        end
    end
end)
