-- Lưu vị trí ban đầu của tất cả model
local savedPositions = {}

-- Hàm lưu tất cả vị trí hiện tại
local function saveAllPositions()
    local count = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            local model = obj.Parent
            -- Chỉ lưu các part chính (root part)
            if obj.Name == "HumanoidRootPart" or obj.Name == "Torso" or obj.Name == "UpperTorso" then
                savedPositions[model] = obj.CFrame
                count = count + 1
            end
        end
    end
    return count
end

-- Tự động lưu vị trí ban đầu
wait(1)
local saved = saveAllPositions()
print("[BTMod] Đã lưu vị trí của " .. saved .. " model!")

-- Nút TP quái vật
tpButton.MouseButton1Click:Connect(function()
    local tpCount = 0
    for model, cframe in pairs(savedPositions) do
        if model and model.Parent then
            local rootPart = model:FindFirstChild("HumanoidRootPart") or 
                           model:FindFirstChild("Torso") or 
                           model:FindFirstChild("UpperTorso")
            if rootPart and rootPart:IsA("BasePart") then
                pcall(function()
                    rootPart.CFrame = cframe
                    rootPart.Velocity = Vector3.new(0, 0, 0)
                    rootPart.RotVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    tpCount = tpCount + 1
                end)
            end
        end
    end
    
    tpButton.Text = "✅ Đã TP " .. tpCount .. " Model!"
    wait(2)
    tpButton.Text = "🔄 TP Quái Về Chỗ Cũ"
    print("[BTMod] Đã teleport " .. tpCount .. " model về vị trí cũ!")
end)

-- Nút kéo trứng
eggButton.MouseButton1Click:Connect(function()
    local character = player.Character
    if not character then
        print("[BTMod] Bạn chưa có nhân vật!")
        return
    end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then
        print("[BTMod] Không tìm thấy nhân vật!")
        return
    end
    
    local eggCount = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or name:find("trung") or name:find("trứng") or name:find("golden") then
                pcall(function()
                    obj.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                    obj.Anchored = false
                    obj.Velocity = Vector3.new(0, 0, 0)
                    eggCount = eggCount + 1
                end)
            end
        end
    end
    
    eggButton.Text = "✅ Đã kéo " .. eggCount .. " trứng!"
    wait(2)
    eggButton.Text = "🥚 Kéo Trứng Đến"
    print("[BTMod] Đã kéo " .. eggCount .. " quả trứng đến gần!")
end)

-- Tự động lưu vị trí mỗi 15 giây
spawn(function()
