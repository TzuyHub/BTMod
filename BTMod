-- Tên Script: BTMod
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BTMod" 
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Button = Instance.new("TextButton")
Button.Name = "BTModButton"
Button.Size = UDim2.new(0, 180, 0, 50)
Button.Position = UDim2.new(0.5, -90, 0.1, 0)
Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0) 
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 13
Button.Text = "Xóa con đang cảnh chừng trứng"
Button.Parent = ScreenGui

local isHidden = false

Button.MouseButton1Click:Connect(function()
    isHidden = not isHidden
    
    if isHidden then
        Button.Text = "HIỆN LẠI PET"
        Button.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
        
        -- Quét toàn bộ pet trong game
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                
                local isCharacter = false
                for _, player in pairs(game.Players:GetPlayers()) do
                    if player.Character == v then
                        isCharacter = true
                        break
                    end
                end
                
                if not isCharacter then
                    v:SetAttribute("HiddenByScript", true)
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 1 -- Trong suốt
                            part.CanCollide = false -- Không bị vướng khi đi lại
                            part.CanTouch = false -- Không thể chạm vào
                            part.CanQuery = false -- Đòn đánh/tia laser KHÔNG TRÚNG được
                        end
                        if part:IsA("Decal") then
                            part.Transparency = 1
                        end
                    end
                    -- Vô hiệu hóa sức mạnh vật lý của pet
                    local primaryPart = v.PrimaryPart
                    if primaryPart then
                        primaryPart.AssemblyLinearVelocity = Vector3.new(0,0,0)
                        primaryPart.AssemblyAngularVelocity = Vector3.new(0,0,0)
                        primaryPart.Anchored = true 
                    end
                end
            end
        end
        
    else
        Button.Text = "Xóa con đang cảnh chừng trứng"
        Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
        
        -- Khôi phục lại pet
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                if v:GetAttribute("HiddenByScript") then
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 0
                            part.CanCollide = true
                            part.CanTouch = true
                            part.CanQuery = true
                            part.Anchored = false
                        end
                        if part:IsA("Decal") then
                            part.Transparency = 0
                        end
                    end
                end
            end
        end
    end
end)
