--[[
    BTMod - Script giáo dục cho game "Lấy trộm một quả trứng"
    LƯU Ý: Chỉ sử dụng cho mục đích học tập
]]

local BTMod = {}

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")

-- Cấu hình
local Settings = {
    MonsterSpeed = 1, -- Tốc độ chậm nhất
    RemoveMonsters = false,
    PreventAttack = true
}

-- Tìm monster trong game
local function FindMonsters()
    local monsters = {}
    
    -- Tìm trong Workspace
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("Humanoid") then
            -- Tìm monster theo tên hoặc tag
            local name = obj.Name:lower()
            if name:find("monster") or name:find("creature") or 
               name:find("beast") or name:find("animal") or
               name:find("enemy") then
                table.insert(monsters, obj)
            end
        end
    end
    
    return monsters
end

-- Làm chậm monster
local function SlowMonsters()
    local monsters = FindMonsters()
    
    for _, monster in pairs(monsters) do
        local humanoid = monster:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid.WalkSpeed = Settings.MonsterSpeed
            humanoid.JumpPower = 0
        end
    end
end

-- Xóa monster
local function RemoveMonsters()
    local monsters = FindMonsters()
    
    for _, monster in pairs(monsters) do
        if monster:IsA("Model") then
            monster:Destroy()
        end
    end
end

-- Ngăn monster tấn công
local function PreventMonsterAttack()
    local monsters = FindMonsters()
    
    for _, monster in pairs(monsters) do
        -- Tìm script tấn công trong monster
        for _, child in pairs(monster:GetDescendants()) do
            if child:IsA("Script") or child:IsA("LocalScript") then
                -- Vô hiệu hóa script tấn công
                if child.Name:lower():find("attack") or 
                   child.Name:lower():find("damage") or
                   child.Name:lower():find("hit") then
                    child.Disabled = true
                end
            end
        end
        
        -- Vô hiệu hóa touch events
        local touchPart = monster:FindFirstChild("HitBox") or 
                          monster:FindFirstChild("DamagePart")
        if touchPart then
            touchPart.CanTouch = false
        end
    end
end

-- Tạo Menu
local function CreateMenu()
    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "BTModMenu"
    ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
    
    -- Frame chính
    local Frame = Instance.new("Frame")
    Frame.Size = UDim2.new(0, 200, 0, 250)
    Frame.Position = UDim2.new(0, 10, 0, 100)
    Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Frame.BorderSizePixel = 0
    Frame.Parent = ScreenGui
    
    -- Title
    local Title = Instance.new("TextLabel")
    Title.Text = "BTMod Menu"
    Title.Size = UDim2.new(1, 0, 0, 30)
    Title.BackgroundColor3 = Color3.fromRGB(255, 180, 0)
    Title.TextColor3 = Color3.new(1, 1, 1)
    Title.Font = Enum.Font.SourceSansBold
    Title.TextSize = 16
    Title.Parent = Frame
    
    -- Button Xóa Monster
    local RemoveBtn = Instance.new("TextButton")
    RemoveBtn.Text = "Xóa Monster"
    RemoveBtn.Size = UDim2.new(1, 0, 0, 35)
    RemoveBtn.Position = UDim2.new(0, 0, 0, 40)
    RemoveBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    RemoveBtn.TextColor3 = Color3.new(1, 1, 1)
    RemoveBtn.Parent = Frame
    RemoveBtn.MouseButton1Click:Connect(RemoveMonsters)
    
    -- Button Làm chậm Monster
    local SlowBtn = Instance.new("TextButton")
    SlowBtn.Text = "Làm chậm Monster"
    SlowBtn.Size = UDim2.new(1, 0, 0, 35)
    SlowBtn.Position = UDim2.new(0, 0, 0, 85)
    SlowBtn.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
    SlowBtn.TextColor3 = Color3.new(1, 1, 1)
    SlowBtn.Parent = Frame
    SlowBtn.MouseButton1Click:Connect(SlowMonsters)
    
    -- Button Ngăn tấn công
    local NoAttackBtn = Instance.new("TextButton")
    NoAttackBtn.Text = "Ngăn Tấn Công"
    NoAttackBtn.Size = UDim2.new(1, 0, 0, 35)
    NoAttackBtn.Position = UDim2.new(0, 0, 0, 130)
    NoAttackBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 200)
    NoAttackBtn.TextColor3 = Color3.new(1, 1, 1)
    NoAttackBtn.Parent = Frame
    NoAttackBtn.MouseButton1Click:Connect(PreventMonsterAttack)
    
    -- Kéo menu
    local dragging = false
    local dragStart = nil
    local startPos = nil
    
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position
        end
    end)
    
    Title.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = false
        end
    end)
    
    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local delta = input.Position - dragStart
            Frame.Position = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
        end
    end
end

-- Khởi tạo
local function Init()
    -- Tạo menu
    CreateMenu()
    
    -- Auto làm chậm monster khi spawn
    game:GetService("RunService").Heartbeat:Connect(function()
        if Settings.PreventAttack then
            PreventMonsterAttack()
        end
    end)
    
    -- Theo dõi monster mới spawn
    Workspace.DescendantAdded:Connect(function(descendant)
        wait(1) -- Đợi monster load xong
        if Settings.PreventAttack then
            PreventMonsterAttack()
        end
        SlowMonsters()
    end)
end

-- Bắt đầu
Init()
