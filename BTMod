-- Tên Script: BTMod (Phiên bản nâng cấp: Kéo thả nút)
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BTMod" 
ScreenGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false
ScreenGui.IgnoreGuiInset = true -- Cho phép nút kéo ra sát mép màn hình

-- Tạo nút bấm
local Button = Instance.new("TextButton")
Button.Name = "BTModButton"
Button.Size = UDim2.new(0, 220, 0, 50)
Button.Position = UDim2.new(0.5, -110, 0.1, 0) -- Vị trí mặc định
Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0) 
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 12
Button.Text = "Xóa con đang cảnh chừng trứng"
Button.Parent = ScreenGui

-- Thêm nút nhỏ để mở rộng/ẩn nút chính (tùy chọn, nhưng hữu ích để bấm cho dễ)
local DragBar = Instance.new("Frame")
DragBar.Size = UDim2.new(0, 220, 0, 20)
DragBar.Position = UDim2.new(0, 0, 0, -20)
DragBar.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
DragBar.BorderSizePixel = 0
DragBar.Parent = Button
DragBar.Text = "Di chuyển"

local isActive = false
local dragging = false
local dragInput, dragStart, startPos

-- Các hàm xử lý kéo thả
local function update(Input)
    local delta = Input.Position - dragStart
    Button.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

DragBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Button.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

DragBar.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        update(input)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        update(input)
    end
end)

-- Chức năng chính: Khóa Pet
Button.MouseButton1Click:Connect(function()
    isActive = not isActive
    
    if isActive then
        Button.Text = "Mở khóa Pet"
        Button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) 
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                
                -- Kiểm tra xem có phải là nhân vật người chơi không (tránh khóa nhầm chính mình)
                local isCharacter = false
                for _, player in pairs(Players:GetPlayers()) do
                    if player.Character == v then
                        isCharacter = true
                        break
                    end
                end
                
                if not isCharacter then
                    v:SetAttribute("FrozenByBTMod", true)
                    
                    -- 1. Tắt não (AI)
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                        humanoid.PlatformStand = true
                    end
                    
                    -- 2. Phá vỡ khớp nối
                    for _, joint in pairs(v:GetJoints()) do
                        joint:Destroy()
                    end
                    
                    -- 3. Khóa cứng (Anchor) và tắt va chạm
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored = true
                            part.CanCollide = false
                            part.CanTouch = false
                            part.CanQuery = false
                        end
                    end
                    
                    -- 4. Vô hiệu hóa Script của Server
                    for _, script in pairs(v:GetDescendants()) do
                        if script:IsA("Script") or script:IsA("LocalScript") then
                            script.Disabled = true
                        end
                    end
                    
                    -- 5. Đẩy nó ra xa người chơi (Dưới đất)
                    v:PivotTo(CFrame.new(0, -1000, 0))
                end
            end
        end
        
    else
        Button.Text = "Xóa con đang cảnh chừng trứng"
        Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
        
        -- Khôi phục lại pet
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                if v:GetAttribute("FrozenByBTMod") then
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 16
                        humanoid.JumpPower = 50
                        humanoid.PlatformStand = false
                    end
                    
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored = false
                            part.CanCollide = true
                            part.CanTouch = true
                            part.CanQuery = true
                        end
                    end
                    
                    for _, script in pairs(v:GetDescendants()) do
                        if script:IsA("Script") or script:IsA("LocalScript") then
                            script.Disabled = false
                        end
                    end
                    
                    -- Đưa về vị trí ban đầu (gần người chơi)
                    v:PivotTo(CFrame.new(Players.LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)))
                end
            end
        end
    end
end)
