-- Script: BTMod
-- Game: Lấy trộm một quả trứng (Steal an Egg)
-- Chức năng: Làm chậm quái vật, teleport trứng, TP quái vật về chỗ cũ

-- Khởi tạo
local BTMod = {}
BTMod.Name = "BTMod"
BTMod.Version = "4.0.0"
BTMod.Enabled = true

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

-- Biến lưu trữ
local player = Players.LocalPlayer
local originalSpeed = {}
local originalPositions = {} -- Lưu vị trí gốc của quái vật
local isRunning = true
local autoSteal = false
local eggs = {}

-- Hàm tìm quái vật
local function findMonsters()
    local monsters = {}
    
    local function searchIn(parent)
        for _, obj in pairs(parent:GetDescendants()) do
            if obj:IsA("Model") then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local name = obj.Name:lower()
                    if name:find("monster") or name:find("quái") or 
                       name:find("guard") or name:find("canh") or
                       name:find("enemy") or name:find("địch") or
                       name:find("beast") or name:find("thú") or
                       name:find("scp") or name:find("entity") then
                        monsters[obj] = humanoid
                    end
                end
            end
        end
    end
    
    searchIn(Workspace)
    
    local folderNames = {"Enemies", "Monsters", "Guards", "NPCs", "Entities", "SCPs"}
    for _, folderName in pairs(folderNames) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            searchIn(folder)
        end
    end
    
    return monsters
end

-- Hàm tìm trứng
local function findEggs()
    local foundEggs = {}
    
    local function searchIn(parent)
        for _, obj in pairs(parent:GetDescendants()) do
            local name = obj.Name:lower()
            if name:find("egg") or name:find("trứng") or name:find("golden") then
                if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("Model") then
                    if obj:IsA("Part") or obj:IsA("MeshPart") then
                        if obj.Size.Magnitude < 20 then
                            table.insert(foundEggs, obj)
                        end
                    end
                end
            end
        end
    end
    
    searchIn(Workspace)
    return foundEggs
end

-- Hàm lưu vị trí gốc của quái vật
local function saveMonsterPositions()
    local monsters = findMonsters()
    local savedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            local rootPart = monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChild("Torso")
            if rootPart and not originalPositions[monster] then
                originalPositions[monster] = rootPart.CFrame
                savedCount = savedCount + 1
            end
        end
    end
    
    return savedCount
end

-- Hàm teleport quái vật về vị trí gốc
local function teleportMonstersBack()
    local monsters = findMonsters()
    local teleportedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            local rootPart = monster:FindFirstChild("HumanoidRootPart") or monster:FindFirstChild("Torso")
            local originalCFrame = originalPositions[monster]
            
            if rootPart and originalCFrame then
                pcall(function()
                    -- Tạo tween mượt mà
                    local tweenInfo = TweenInfo.new(2, Enum.EasingStyle.Linear)
                    local tween = TweenService:Create(rootPart, tweenInfo, {
                        CFrame = originalCFrame
                    })
                    tween:Play()
                    
                    -- Reset vận tốc
                    if rootPart:IsA("BasePart") then
                        rootPart.Velocity = Vector3.new(0, 0, 0)
                        rootPart.RotVelocity = Vector3.new(0, 0, 0)
                    end
                    
                    -- Khôi phục tốc độ
                    if humanoid and originalSpeed[monster] then
                        humanoid.WalkSpeed = originalSpeed[monster]
                    end
                    
                    teleportedCount = teleportedCount + 1
                end)
            end
        end
    end
    
    return teleportedCount
end

-- Hàm làm chậm quái vật
local function slowMonsters(speedMultiplier)
    if not isRunning then return 0 end
    
    -- Lưu vị trí gốc trước khi làm chậm
    saveMonsterPositions()
    
    local monsters = findMonsters()
    local slowedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent and humanoid then
            if not originalSpeed[monster] then
                originalSpeed[monster] = humanoid.WalkSpeed
            end
            
            local newSpeed = math.max(originalSpeed[monster] * 0.05, 0.1)
            if speedMultiplier then
                newSpeed = math.max(originalSpeed[monster] * speedMultiplier, 0.1)
            end
            
            humanoid.WalkSpeed = newSpeed
            slowedCount = slowedCount + 1
        end
    end
    
    return slowedCount
end

-- Hàm vô hiệu hóa tấn công
local function disableAttacks()
    if not isRunning then return 0 end
    
    local monsters = findMonsters()
    local disabledCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            if humanoid then
                pcall(function()
                    humanoid.WalkSpeed = 0.1
                    humanoid.JumpPower = 0
                end)
            end
            
            for _, descendant in pairs(monster:GetDescendants()) do
                if descendant:IsA("Tool") then
                    pcall(function()
                        descendant:Destroy()
                        disabledCount = disabledCount + 1
                    end)
                end
            end
        end
    end
    
    return disabledCount
end

-- Hàm teleport trứng đến người chơi
local function teleportEggToPlayer()
    local character = player.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    eggs = findEggs()
    local teleportedCount = 0
    
    for _, egg in pairs(eggs) do
        if egg and egg.Parent then
            pcall(function()
                if not egg:GetAttribute("BTMod_OriginalPos") then
                    egg:SetAttribute("BTMod_OriginalPos", egg.Position)
                end
                
                local newPos = root.Position + Vector3.new(0, 5, 0)
                egg.CFrame = CFrame.new(newPos)
                egg.Anchored = false
                teleportedCount = teleportedCount + 1
            end)
        end
    end
    
    return teleportedCount
end

-- Hàm tự động lấy trứng
local function autoStealEggs()
    spawn(function()
        while autoSteal and isRunning do
            local character = player.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    eggs = findEggs()
                    for _, egg in pairs(eggs) do
                        if egg and egg.Parent then
                            pcall(function()
                                egg.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                                egg.Anchored = false
                                egg.Touched:Fire(root)
                            end)
                        end
                    end
                end
            end
            wait(0.5)
        end
    end)
end

