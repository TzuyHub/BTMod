-- Hàm tìm quái vật
local function findMonsters()
    local monsters = {}
    
    -- Tìm theo nhiều cách khác nhau
    local function searchIn(parent)
        for _, obj in pairs(parent:GetDescendants()) do
            if obj:IsA("Model") or obj:IsA("Humanoid") then
                -- Tìm theo tên
                local name = obj.Name:lower()
                if name:find("monster") or name:find("quái") or 
                   name:find("guard") or name:find("canh") or
                   name:find("enemy") or name:find("địch") or
                   name:find("beast") or name:find("thú") then
                    local humanoid = obj:FindFirstChildOfClass("Humanoid")
                    if humanoid and humanoid.Health > 0 then
                        if not monsters[obj] then
                            monsters[obj] = humanoid
                        end
                    end
                end
            end
        end
    end
    
    -- Tìm trong Workspace
    searchIn(Workspace)
    
    -- Tìm trong các folder cụ thể
    for _, folderName in pairs({"Enemies", "Monsters", "Guards", "NPCs"}) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            searchIn(folder)
        end
    end
    
    return monsters
end

-- Hàm xóa quái vật
local function deleteMonsters()
    local monsters = findMonsters()
    local deletedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            -- Lưu tốc độ gốc trước khi xóa
            if humanoid and not originalSpeed[monster] then
                originalSpeed[monster] = humanoid.WalkSpeed
            end
            
            -- Xóa quái vật
            pcall(function()
                monster:Destroy()
                deletedCount = deletedCount + 1
            end)
        end
    end
    
    return deletedCount
end

-- Hàm làm chậm quái vật
local function slowMonsters()
    local monsters = findMonsters()
    local slowedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent and humanoid then
            -- Lưu tốc độ gốc nếu chưa lưu
            if not originalSpeed[monster] then
                originalSpeed[monster] = humanoid.WalkSpeed
            end
            
            -- Đặt tốc độ về mức tối thiểu (chậm nhất có thể)
            if humanoid.WalkSpeed > 1 then
                humanoid.WalkSpeed = 1 -- Tốc độ chậm nhất
                slowedCount = slowedCount + 1
            end
        end
    end
    
    return slowedCount
end

-- Hàm vô hiệu hóa tấn công
local function disableAttacks()
    local monsters = findMonsters()
    local disabledCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            -- Tìm các script tấn công
            for _, script in pairs(monster:GetDescendants()) do
                if script:IsA("Script") or script:IsA("LocalScript") then
                    local scriptName = script.Name:lower()
                    if scriptName:find("attack") or scriptName:find("tấn công") or
                       scriptName:find("damage") or scriptName:find("sát thương") or
                       scriptName:find("hit") or scriptName:find("đánh") then
                        -- Vô hiệu hóa script tấn công
                        pcall(function()
                            script.Disabled = true
                            disabledCount = disabledCount + 1
                        end)
                    end
                end
            end
            
            -- Tìm các tool tấn công
            for _, tool in pairs(monster:GetDescendants()) do
                if tool:IsA("Tool") and tool:FindFirstChild("Handle") then
                    pcall(function()
                        tool.Enabled = false
                        disabledCount = disabledCount + 1
                    end)
                end
            end
        end
    end
    
    return disabledCount
end

