-- Hàm theo dõi quái vật mới
local function watchForNewMonsters()
    Workspace.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Model") and isRunning then
            wait(1) -- Đợi model load xong
            local humanoid = descendant:FindFirstChildOfClass("Humanoid")
            if humanoid then
                -- Lưu vị trí ngay khi quái vật mới xuất hiện
                local rootPart = descendant:FindFirstChild("HumanoidRootPart") or 
                               descendant:FindFirstChild("Torso")
                if rootPart then
                    originalPositions[descendant] = {
                        CFrame = rootPart.CFrame,
                        Position = rootPart.Position,
                        Rotation = rootPart.Rotation
                    }
                end
                
                if isRunning then
                    slowMonsters(0.05)
                    disableAttacks()
                end
            end
        end
    end)
end

