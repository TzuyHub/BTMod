-- Tạo GUI
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FPSBooster"
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0, 150, 0, 50)
Button.Position = UDim2.new(0.5, -75, 0.1, 0)
Button.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
Button.TextColor3 = Color3.fromRGB(0, 0, 0)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 20
Button.Text = "TĂNG FPS"
Button.Parent = ScreenGui

local isHidden = false -- Biến kiểm tra trạng thái

Button.MouseButton1Click:Connect(function()
    isHidden = not isHidden -- Đảo trạng thái Bật/Tắt
    
    if isHidden then
        Button.Text = "HIỆN PET LẠI"
        Button.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
        
        -- Lặp qua tất cả các vật thể trong game
        for _, v in pairs(workspace:GetDescendants()) do
            -- Tìm các con Pet (thường là Model có Humanoid hoặc tên chứa 'Pet')
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                v:SetAttribute("HiddenByScript", true) -- Đánh dấu để nhớ
                v.PrimaryPart.Transparency = 1
                for _, part in pairs(v:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.Transparency = 1 -- Làm trong suốt
                        part.CanCollide = false -- Không va chạm
                        part.CanQuery = false -- Không bị raycast
                    end
                    if part:IsA("Decal") then
                        part.Transparency = 1
                    end
                end
            end
        end
    else
        Button.Text = "TĂNG FPS"
        Button.BackgroundColor3 = Color3.fromRGB(0, 255, 127)
        
        -- Khôi phục lại
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                if v:GetAttribute("HiddenByScript") then
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Transparency = 0
                            part.CanCollide = true
                            part.CanQuery = true
                        end
                        if part:IsA("Decal") then
                            part.Transparency = 0
                        end
                    end
                end
            end
        end
    end
end)
