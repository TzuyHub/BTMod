-- Make GUI Draggable
local dragging
local dragInput
local dragStart
local startPos

local function update(input)
    local delta = input.Position - dragStart
    MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end

TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TitleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        update(input)
    end
end)

-- [[ LOGIC FARM ]]
task.spawn(function()
    while true do
        if getgenv().AutoFarm then
            local hasEgg = false
            if Player.Backpack then
                for _, item in pairs(Player.Backpack:GetChildren()) do
                    if item.Name:lower():find("egg") then
                        hasEgg = true
                    end
                end
            end
            
            if hasEgg and getgenv().AutoTweenBase then
                -- Tween về căn cứ
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("base") then
                        local tween = TweenService:Create(HRP, TweenInfo.new(0.5), {CFrame = CFrame.new(obj.Position + Vector3.new(0, 5, 0))})
                        tween:Play()
                        tween.Completed:Wait()
                        firetouchinterest(HRP, obj, 0)
                        firetouchinterest(HRP, obj, 1)
                        break
                    end
                end
            elseif getgenv().AutoCollect and not hasEgg then
                -- Tìm trứng
                local nearest = nil
                local minDist = math.huge
                for _, obj in pairs(workspace:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
                        local dist = (HRP.Position - obj.Position).Magnitude
                        if dist < minDist then
                            minDist = dist
                            nearest = obj
                        end
                    end
                end
                
                if nearest then
                    local tween = TweenService:Create(HRP, TweenInfo.new(0.3), {CFrame = CFrame.new(nearest.Position + Vector3.new(0, 5, 0))})
                    tween:Play()
                    tween.Completed:Wait()
                    firetouchinterest(HRP, nearest, 0)
                    firetouchinterest(HRP, nearest, 1)
                end
            end
        end
        task.wait(0.3)
    end
end)

