-- Script: BTMod
-- Game: Lấy trộm một quả trứng (Steal an Egg)
-- Chức năng: Làm chậm quái vật, teleport trứng, TP quái vật về chỗ cũ

-- Khởi tạo
local BTMod = {}
BTMod.Name = "BTMod"
BTMod.Version = "5.0.0"
BTMod.Enabled = true

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

-- Biến lưu trữ
local player = Players.LocalPlayer
local originalSpeed = {}
local originalPositions = {} -- Lưu vị trí gốc của quái vật
local isRunning = true
local autoSteal = false
local eggs = {}

-- Hàm tìm tất cả quái vật (mở rộng tìm kiếm)
local function findMonsters()
    local monsters = {}
    
    -- Tìm tất cả Humanoid trong game
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 then
            local model = obj.Parent
            if model and model:IsA("Model") then
                local name = model.Name:lower()
                -- Kiểm tra nếu không phải là người chơi
                local isPlayer = false
                for _, plr in pairs(Players:GetPlayers()) do
                    if plr.Character == model then
                        isPlayer = true
                        break
                    end
                end
                
                if not isPlayer then
                    monsters[model] = obj
                end
            end
        end
    end
    
    return monsters
end

-- Hàm tìm trứng
local function findEggs()
    local foundEggs = {}
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        local name = obj.Name:lower()
        if name:find("egg") or name:find("trứng") or name:find("golden") then
            if obj:IsA("Part") or obj:IsA("MeshPart") then
                if obj.Size.Magnitude < 20 then
                    table.insert(foundEggs, obj)
                end
            end
        end
    end
    
    return foundEggs
end

-- Hàm lưu vị trí gốc của quái vật (CHẠY NGAY LẬP TỨC)
local function saveMonsterPositions()
    local monsters = findMonsters()
    local savedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            -- Tìm root part
            local rootPart = monster:FindFirstChild("HumanoidRootPart") or 
                           monster:FindFirstChild("Torso") or
                           monster:FindFirstChild("UpperTorso")
            
            if rootPart and rootPart:IsA("BasePart") then
                -- Lưu vị trí CHÍNH XÁC
                originalPositions[monster] = {
                    CFrame = rootPart.CFrame,
                    Position = rootPart.Position,
                    Rotation = rootPart.Rotation
                }
                savedCount = savedCount + 1
                print("[BTMod] Đã lưu vị trí của: " .. monster.Name)
            end
        end
    end
    
    return savedCount
end

-- Hàm teleport quái vật về vị trí gốc (SỬA LẠI)
local function teleportMonstersBack()
    local monsters = findMonsters()
    local teleportedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            local rootPart = monster:FindFirstChild("HumanoidRootPart") or 
                           monster:FindFirstChild("Torso") or
                           monster:FindFirstChild("UpperTorso")
            
            local savedData = originalPositions[monster]
            
            if rootPart and rootPart:IsA("BasePart") and savedData then
                pcall(function()
                    -- Teleport TRỰC TIẾP (không dùng tween để chắc chắn)
                    rootPart.CFrame = savedData.CFrame
                    rootPart.Position = savedData.Position
                    rootPart.Rotation = savedData.Rotation
                    
                    -- Reset vận tốc
                    rootPart.Velocity = Vector3.new(0, 0, 0)
                    rootPart.RotVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                    rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    -- Khôi phục tốc độ
                    if humanoid and originalSpeed[monster] then
                        humanoid.WalkSpeed = originalSpeed[monster]
                    end
                    
                    teleportedCount = teleportedCount + 1
                    print("[BTMod] Đã TP " .. monster.Name .. " về vị trí gốc!")
                end)
            end
        end
    end
    
    return teleportedCount
end

-- Hàm làm chậm quái vật
local function slowMonsters(speedMultiplier)
    if not isRunning then return 0 end
    
    local monsters = findMonsters()
    local slowedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent and humanoid then
            if not originalSpeed[monster] then
                originalSpeed[monster] = humanoid.WalkSpeed
            end
            
            local newSpeed = math.max(originalSpeed[monster] * 0.05, 0.1)
            if speedMultiplier then
                newSpeed = math.max(originalSpeed[monster] * speedMultiplier, 0.1)
            end
            
            humanoid.WalkSpeed = newSpeed
            slowedCount = slowedCount + 1
        end
    end
    
    return slowedCount
end

-- Hàm vô hiệu hóa tấn công
local function disableAttacks()
    if not isRunning then return 0 end
    
    local monsters = findMonsters()
    local disabledCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            if humanoid then
                pcall(function()
                    humanoid.WalkSpeed = 0.1
                    humanoid.JumpPower = 0
                end)
            end
            
            for _, descendant in pairs(monster:GetDescendants()) do
                if descendant:IsA("Tool") then
                    pcall(function()
                        descendant:Destroy()
                        disabledCount = disabledCount + 1
                    end)
                end
            end
        end
    end
    
    return disabledCount
end

-- Hàm teleport trứng đến người chơi
local function teleportEggToPlayer()
    local character = player.Character
    if not character then return false end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    
    eggs = findEggs()
    local teleportedCount = 0
    
    for _, egg in pairs(eggs) do
        if egg and egg.Parent then
            pcall(function()
                local newPos = root.Position + Vector3.new(0, 5, 0)
                egg.CFrame = CFrame.new(newPos)
                egg.Anchored = false
                teleportedCount = teleportedCount + 1
            end)
        end
    end
    
    return teleportedCount
end

-- Hàm tự động lấy trứng
local function autoStealEggs()
    spawn(function()
        while autoSteal and isRunning do
            local character = player.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    eggs = findEggs()
                    for _, egg in pairs(eggs) do
                        if egg and egg.Parent then
                            pcall(function()
                                egg.CFrame = root.CFrame * CFrame.new(0, 0, -3)
                                egg.Anchored = false
                                egg.Touched:Fire(root)
                            end)
                        end
                    end
                end
            end
            wait(0.5)
        end
    end)
end

