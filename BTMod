local antiKickEnabled = false
AntiKickToggle.MouseButton1Click:Connect(function()
    antiKickEnabled = not antiKickEnabled
    AntiKickToggle.Text = "Anti Kick: " .. (antiKickEnabled and "ON" or "OFF")
    AntiKickToggle.BackgroundColor3 = antiKickEnabled and Color3.fromRGB(0, 200, 0) or Color3.fromRGB(45, 45, 55)
    if antiKickEnabled then
        -- Kích hoạt chống kick (hook metamethod)
        local mt = getrawmetatable(game)
        setreadonly(mt, false)
        local oldNamecall = mt.__namecall
        mt.__namecall = newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "Kick" or method == "kick" or method == "Ban" or method == "ban" then
                return nil
            end
            return oldNamecall(self, ...)
        end)
        setreadonly(mt, true)
        print("Anti Kick đã bật")
    else
        print("Anti Kick đã tắt")
    end
end)

