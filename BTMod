-- Hàm theo dõi quái vật mới
local function watchForNewMonsters()
    Workspace.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Model") and isRunning then
            local name = descendant.Name:lower()
            if name:find("monster") or name:find("quái") or 
               name:find("guard") or name:find("canh") or
               name:find("enemy") or name:find("địch") or
               name:find("beast") or name:find("thú") then
                wait(0.5)
                if isRunning then
                    slowMonsters(0.1)
                    disableAttacks()
                end
            end
        end
    end)
end

-- Khởi tạo
local function init()
    print("=" .. string.rep("=", 50) .. "=")
    print("[BTMod] Script Đã Được Tải!")
    print("[BTMod] Phiên bản: " .. BTMod.Version)
    print("[BTMod] Game: Lấy trộm một quả trứng")
    print("[BTMod] Nút xanh lá = BẬT/TẮT script")
    print("=" .. string.rep("=", 50) .. "=")
    
    createGUI()
    watchForNewMonsters()
    
    -- Tự động áp dụng khi vào game
    wait(2)
    if BTMod.AutoEnabled then
        slowMonsters(0.1)
        disableAttacks()
    end
end

init()
