-- Script: BTMod
-- Game: Lấy trộm một quả trứng (Steal an Egg)
-- Chức năng: Làm chậm quái vật, vô hiệu hóa tấn công và đổ lỗi cho người khác

-- Khởi tạo
local BTMod = {}
BTMod.Name = "BTMod"
BTMod.Version = "2.0.0"
BTMod.Enabled = true
BTMod.AutoEnabled = true

-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- Biến lưu trữ
local player = Players.LocalPlayer
local originalSpeed = {}
local isRunning = true
local blameEnabled = true -- Tính năng đổ lỗi

-- Hàm tìm quái vật
local function findMonsters()
    local monsters = {}
    
    local function searchIn(parent)
        for _, obj in pairs(parent:GetDescendants()) do
            if obj:IsA("Model") then
                local humanoid = obj:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local name = obj.Name:lower()
                    if name:find("monster") or name:find("quái") or 
                       name:find("guard") or name:find("canh") or
                       name:find("enemy") or name:find("địch") or
                       name:find("beast") or name:find("thú") or
                       name:find("scp") or name:find("entity") then
                        monsters[obj] = humanoid
                    end
                end
            end
        end
    end
    
    searchIn(Workspace)
    
    local folderNames = {"Enemies", "Monsters", "Guards", "NPCs", "Entities", "SCPs"}
    for _, folderName in pairs(folderNames) do
        local folder = Workspace:FindFirstChild(folderName)
        if folder then
            searchIn(folder)
        end
    end
    
    return monsters
end

-- Hàm làm chậm quái vật
local function slowMonsters(speedMultiplier)
    if not isRunning then return 0 end
    
    local monsters = findMonsters()
    local slowedCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent and humanoid then
            if not originalSpeed[monster] then
                originalSpeed[monster] = humanoid.WalkSpeed
            end
            
            local newSpeed = math.max(originalSpeed[monster] * 0.1, 0.5)
            if speedMultiplier then
                newSpeed = math.max(originalSpeed[monster] * speedMultiplier, 0.3)
            end
            
            if humanoid.WalkSpeed > newSpeed then
                humanoid.WalkSpeed = newSpeed
                slowedCount = slowedCount + 1
            end
        end
    end
    
    return slowedCount
end

-- Hàm vô hiệu hóa tấn công
local function disableAttacks()
    if not isRunning then return 0 end
    
    local monsters = findMonsters()
    local disabledCount = 0
    
    for monster, humanoid in pairs(monsters) do
        if monster and monster.Parent then
            for _, descendant in pairs(monster:GetDescendants()) do
                if descendant:IsA("Script") or descendant:IsA("LocalScript") then
                    local scriptName = descendant.Name:lower()
                    if scriptName:find("attack") or scriptName:find("tấn công") or
                       scriptName:find("damage") or scriptName:find("sát thương") or
                       scriptName:find("hit") or scriptName:find("đánh") or
                       scriptName:find("kill") or scriptName:find("giết") then
                        pcall(function()
                            descendant.Disabled = true
                            disabledCount = disabledCount + 1
                        end)
                    end
                end
                
                if descendant:IsA("Tool") and descendant:FindFirstChild("Handle") then
                    pcall(function()
                        descendant.Enabled = false
                        disabledCount = disabledCount + 1
                    end)
                end
            end
        end
    end
    
    return disabledCount
end

-- Hàm tìm người chơi khác ở xa để đổ lỗi
local function findFarPlayer()
    local farthestPlayer = nil
    local farthestDistance = 0
    
    for _, otherPlayer in pairs(Players:GetPlayers()) do
        if otherPlayer ~= player then
            local otherCharacter = otherPlayer.Character
            local myCharacter = player.Character
            
            if otherCharacter and myCharacter then
                local otherRoot = otherCharacter:FindFirstChild("HumanoidRootPart")
                local myRoot = myCharacter:FindFirstChild("HumanoidRootPart")
                
                if otherRoot and myRoot then
                    local distance = (otherRoot.Position - myRoot.Position).Magnitude
                    if distance > farthestDistance then
                        farthestDistance = distance
                        farthestPlayer = otherPlayer
                    end
                end
            end
        end
    end
    
    return farthestPlayer
end

-- Hàm chặn và thay đổi thông tin trộm trứng
local function setupBlameSystem()
    -- Chặn các RemoteEvent liên quan đến trộm trứng
    local function interceptRemotes()
        -- Tìm tất cả RemoteEvent trong game
        local remotes = {}
        
        local function findRemotes(parent)
            for _, obj in pairs(parent:GetDescendants()) do
                if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
                    local name = obj.Name:lower()
                    if name:find("steal") or name:find("trộm") or
                       name:find("egg") or name:find("trứng") or
                       name:find("theft") or name:find("rob") or
                       name:find("take") or name:find("lấy") or
                       name:find("grab") or name:find("catch") then
                        table.insert(remotes, obj)
                    end
                end
            end
        end
        
        findRemotes(ReplicatedStorage)
        findRemotes(Workspace)
        
        -- Chặn các remote
        for _, remote in pairs(remotes) do
            if not remote:GetAttribute("BTMod_Hooked") then
                remote:SetAttribute("BTMod_Hooked", true)
                
                -- Lưu hàm gốc
                local originalFireServer = remote.FireServer
                
                -- Thay đổi hàm FireServer
                remote.FireServer = function(self, ...)
                    if blameEnabled and isRunning then
                        local args = {...}
                        local farPlayer = findFarPlayer()
                        
                        if farPlayer then
                            -- Thay đổi thông tin người chơi
                            for i, arg in pairs(args) do
                                if typeof(arg) == "Instance" and arg:IsA("Player") then
                                    args[i] = farPlayer
                                elseif typeof(arg) == "string" and arg == player.Name then
                                    args[i] = farPlayer.Name
                                elseif typeof(arg) == "number" and arg == player.UserId then
                                    args[i] = farPlayer.UserId
                                end
                            end
                            
                            -- Gửi với thông tin đã thay đổi
                            return originalFireServer(self, unpack(args))
                        end
                    end
                    
                    -- Gửi bình thường nếu không có người chơi khác
                    return originalFireServer(self, ...)
                end
            end
        end
    end
    
    -- Chặn các sự kiện trộm trứng
    local function interceptEggEvents()
        -- Tìm tất cả trứng trong game
        local eggs = {}
        
        local function findEggs(parent)
            for _, obj in pairs(parent:GetDescendants()) do
                local name = obj.Name:lower()
                if name:find("egg") or name:find("trứng") then
                    if obj:IsA("Part") or obj:IsA("MeshPart") or obj:IsA("Model") then
                        table.insert(eggs, obj)
                    end
                end
            end
        end
        
        findEggs(Workspace)
        
        -- Theo dõi sự kiện chạm vào trứng
        for _, egg in pairs(eggs) do
            if egg:IsA("Part") or egg:IsA("MeshPart") then
                egg.Touched:Connect(function(hit)
                    if blameEnabled and isRunning then
                        local character = hit.Parent
                        if character and character:FindFirstChild("Humanoid") then
                            local touchingPlayer = Players:GetPlayerFromCharacter(character)
                            if touchingPlayer == player then
                                -- Đổ lỗi cho người chơi khác
                                local farPlayer = findFarPlayer()
                                if farPlayer then
                                    print("[BTMod] Đã đổ lỗi trộm trứng cho: " .. farPlayer.Name)
                                    
                                    -- Tạo fake touch từ người chơi khác
                                    local fakeTouch = Instance.new("Part")
                                    fakeTouch.Name = "FakeTouch"
                                    fakeTouch.Size = Vector3.new(1, 1, 1)
                                    fakeTouch.CanCollide = false
                                    fakeTouch.Transparency = 1
                                    fakeTouch.Position = egg.Position
                                    fakeTouch.Parent = farPlayer.Character
                                    
                                    -- Xóa fake touch sau khi dùng
                                    wait(0.1)
                                    fakeTouch:Destroy()
                                end
                            end
                        end
                    end
                end)
            end
        end
    end
    
    -- Chặn các function liên quan
    local function hookFunctions()
        -- Hook vào các function kiểm tra trộm
        if game:GetService("Players").LocalPlayer then
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
                local method = getnamecallmethod()
                local args = {...}
                
                if blameEnabled and isRunning then
                    if method == "FireServer" or method == "InvokeServer" then
                        local farPlayer = findFarPlayer()
                        if farPlayer then
                            -- Thay đổi args
                            for i, arg in pairs(args) do
                                if typeof(arg) == "Instance" and arg:IsA("Player") then
                                    args[i] = farPlayer
                                elseif typeof(arg) == "string" and arg == player.Name then
                                    args[i] = farPlayer.Name
                                end
                            end
                            
                            return oldNamecall(self, unpack(args))
                        end
                    end
                end
                
                return oldNamecall(self, ...)
            end)
        end
    end
    
    -- Chạy các hàm chặn
    interceptRemotes()
    interceptEggEvents()
    hookFunctions()
    
    -- Liên tục cập nhật
    spawn(function()
        while wait(5) do
            if isRunning and blameEnabled then
                interceptRemotes()
                interceptEggEvents()
            end
        end
    end)
end

-- Hàm khôi phục tốc độ
local function restoreSpeed()
    for monster, speed in pairs(originalSpeed) do
        if monster and monster.Parent then
            local humanoid = monster:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid.WalkSpeed = speed
            end
        end
    end
    originalSpeed = {}
end

