-- Tạo nút bấm
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "FPSDestroyer"
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Button = Instance.new("TextButton")
Button.Size = UDim2.new(0, 150, 0, 50)
Button.Position = UDim2.new(0.5, -75, 0.1, 0)
Button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Màu đỏ
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 20
Button.Text = "XÓA PET (TĂNG FPS)"
Button.Parent = ScreenGui

Button.MouseButton1Click:Connect(function()
    -- Lặp qua tất cả các Model trong Workspace
    for _, v in pairs(workspace:GetDescendants()) do
        
        -- Điều kiện nhận diện Pet (Model có Humanoid, hoặc có tên chứa 'Pet', hoặc do người chơi sở hữu)
        if v:IsA("Model") and v:FindFirstChild("Humanoid") then
            
            -- Kiểm tra xem có phải là nhân vật người chơi không (để không xóa nhầm)
            local isCharacter = false
            for _, player in pairs(game.Players:GetPlayers()) do
                if player.Character == v then
                    isCharacter = true
                    break
                end
            end
            
            -- Nếu không phải nhân vật người chơi thì tiến hành xóa
            if not isCharacter then
                -- Phá hủy toàn bộ model (Xóa vĩnh viễn khỏi bộ nhớ game)
                v:Destroy() 
            end
        end
    end
    
    -- Thông báo nhỏ
    game:GetService("StarterGui"):SetCore("SendNotification", {
        Title = "Thành công!",
        Text = "Đã xóa toàn bộ pet không tồn tại trong game!",
        Duration = 3
    })
end)
