-- Tên Script: BTMod
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "BTMod" 
ScreenGui.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
ScreenGui.ResetOnSpawn = false

local Button = Instance.new("TextButton")
Button.Name = "BTModButton"
Button.Size = UDim2.new(0, 220, 0, 50)
Button.Position = UDim2.new(0.5, -110, 0.1, 0)
Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0) 
Button.TextColor3 = Color3.fromRGB(255, 255, 255)
Button.Font = Enum.Font.GothamBold
Button.TextSize = 13
Button.Text = "Khóa cứng Pet (Không đánh được)"
Button.Parent = ScreenGui

local isActive = false

Button.MouseButton1Click:Connect(function()
    isActive = not isActive
    
    if isActive then
        Button.Text = "Mở khóa Pet"
        Button.BackgroundColor3 = Color3.fromRGB(255, 0, 0) -- Màu đỏ khi đang khóa
        
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                
                -- Kiểm tra xem có phải là nhân vật người chơi không (tránh khóa nhầm chính mình)
                local isCharacter = false
                for _, player in pairs(game.Players:GetPlayers()) do
                    if player.Character == v then
                        isCharacter = true
                        break
                    end
                end
                
                if not isCharacter then
                    v:SetAttribute("FrozenByBTMod", true)
                    
                    -- 1. Tắt não (AI)
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 0
                        humanoid.JumpPower = 0
                        humanoid.PlatformStand = true
                        humanoid:ChangeState(Enum.HumanoidStateType.Physics) -- Ép về trạng thái vật lý
                    end
                    
                    -- 2. Phá vỡ khớp nối (Break Joints) để chúng không thể xoay hoặc cử động chân
                    for _, joint in pairs(v:GetJoints()) do
                        joint:Destroy()
                    end
                    
                    -- 3. Khóa cứng (Anchor) toàn bộ các bộ phận
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored = true -- Quan trọng nhất: Không cho vật lý đụng vào
                            part.CanCollide = false
                            part.CanTouch = false
                            part.CanQuery = false -- Đòn đánh xuyên qua
                        end
                    end
                    
                    -- 4. Vô hiệu hóa Script của Server đang điều khiển nó
                    for _, script in pairs(v:GetDescendants()) do
                        if script:IsA("Script") or script:IsA("LocalScript") then
                            script.Disabled = true
                        end
                    end
                    
                    -- 5. Đẩy nó ra xa người chơi (Dưới đất) để tuyệt đối không thể chạm vào bạn
                    v:PivotTo(CFrame.new(0, -1000, 0))
                end
            end
        end
        
    else
        Button.Text = "Khóa cứng Pet (Không đánh được)"
        Button.BackgroundColor3 = Color3.fromRGB(255, 69, 0)
        
        -- Khôi phục lại pet
        for _, v in pairs(workspace:GetDescendants()) do
            if v:IsA("Model") and v:FindFirstChild("Humanoid") then
                if v:GetAttribute("FrozenByBTMod") then
                    local humanoid = v:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        humanoid.WalkSpeed = 16
                        humanoid.JumpPower = 50
                        humanoid.PlatformStand = false
                    end
                    
                    for _, part in pairs(v:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.Anchored = false
                            part.CanCollide = true
                            part.CanTouch = true
                            part.CanQuery = true
                        end
                    end
                    
                    for _, script in pairs(v:GetDescendants()) do
                        if script:IsA("Script") or script:IsA("LocalScript") then
                            script.Disabled = false
                        end
                    end
                    
                    -- Đưa về vị trí ban đầu (gần người chơi)
                    v:PivotTo(CFrame.new(game.Players.LocalPlayer.Character.HumanoidRootPart.Position + Vector3.new(0, 5, 0)))
                end
            end
        end
    end
end)
