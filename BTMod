    print("=" .. string.rep("=", 60) .. "=")
    
    createGUI()
    watchForNewMonsters()
    
    -- Lưu vị trí quái vật NGAY LẬP TỨC khi script chạy
    wait(1)
    local savedCount = saveMonsterPositions()
    print("[BTMod] Đã lưu vị trí của " .. savedCount .. " quái vật!")
    
    -- Lưu lại sau mỗi 10 giây để cập nhật vị trí mới
    spawn(function()
        while true do
            wait(10)
            if isRunning then
                saveMonsterPositions()
            end
        end
    end)
    
    -- Tự động áp dụng khi vào game
    if BTMod.Enabled then
        slowMonsters(0.05)
        disableAttacks()
    end
end

init()
