-- Hàm theo dõi quái vật mới spawn
local function watchForNewMonsters()
    local lastMonsterCount = 0
    
    Workspace.DescendantAdded:Connect(function(descendant)
        if descendant:IsA("Model") or descendant:IsA("Humanoid") then
            local name = descendant.Name:lower()
            if name:find("monster") or name:find("quái") or 
               name:find("guard") or name:find("canh") or
               name:find("enemy") or name:find("địch") or
               name:find("beast") or name:find("thú") then
                -- Quái vật mới xuất hiện
                wait(1) -- Đợi quái vật load xong
                if BTMod.Enabled then
                    slowMonsters()
                    disableAttacks()
                end
            end
        end
    end)
end

