-- Lưu vị trí ban đầu
local savedPositions = {}

-- Hàm lưu tất cả vị trí
local function saveAllPositions()
    local count = 0
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Parent and obj.Parent:IsA("Model") then
            if obj.Name == "HumanoidRootPart" or obj.Name == "Torso" or obj.Name == "UpperTorso" then
                savedPositions[obj.Parent] = obj.CFrame
                count = count + 1
            end
        end
    end
    return count
end

-- Tự động lưu vị trí
wait(1)
saveAllPositions()

-- Biến điều khiển auto farm
local autoFarm = false
local currentTween = nil

-- Hàm tìm trứng xịn nhất
local function findBestEgg()
    local bestEgg = nil
    local bestValue = 0
    
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            local name = obj.Name:lower()
            if name:find("egg") or name:find("trung") or name:find("trứng") or name:find("golden") then
                -- Đánh giá độ xịn của trứng
                local value = 0
                
                -- Trứng to hơn = xịn hơn
                value = value + obj.Size.Magnitude
                
                -- Trứng vàng = xịn nhất
                if name:find("golden") or name:find("vàng") or name:find("vang") then
                    value = value + 1000
                end
                
                -- Trứng hiếm
                if name:find("rare") or name:find("hiếm") or name:find("hiem") then
                    value = value + 500
                end
                
                -- Trứng đặc biệt
                if name:find("special") or name:find("đặc biệt") or name:find("dac biet") then
                    value = value + 800
                end
                
                -- Trứng màu sắc đặc biệt
                if obj.BrickColor == BrickColor.new("Bright yellow") or 
                   obj.BrickColor == BrickColor.new("Bright red") or
                   obj.BrickColor == BrickColor.new("Bright blue") then
                    value = value + 300
                end
                
                if value > bestValue then
                    bestValue = value
                    bestEgg = obj
                end
            end
        end
    end
    
    return bestEgg
end

-- Hàm tween nhanh đến trứng
local function tweenToEgg(egg)
    local character = player.Character
    if not character then return end
    
    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    
    -- Tween siêu nhanh
    local tweenInfo = TweenInfo.new(
        0.3, -- Thời gian siêu ngắn
        Enum.EasingStyle.Linear, -- Chạy thẳng
        Enum.EasingDirection.Out
    )
    
    local targetCFrame = egg.CFrame * CFrame.new(0, 0, 3)
    local tween = TweenService:Create(root, tweenInfo, {CFrame = targetCFrame})
    
    -- Hủy tween cũ nếu có
    if currentTween then
        currentTween:Cancel()
    end
    
    currentTween = tween
    tween:Play()
    
    -- Chờ tween hoàn thành
    tween.Completed:Wait()
    
    -- Kéo trứng vào người
    pcall(function()
        egg.CFrame = root.CFrame * CFrame.new(0, 0, -2)
        egg.Anchored = false
        egg.Velocity = Vector3.new(0, 0, 0)
        
        -- Kích hoạt sự kiện chạm
        egg.Touched:Fire(root)
    end)
end

-- Hàm auto farm chính
local function autoFarmEggs()
    spawn(function()
        while autoFarm do
            local character = player.Character
            if character then
                local root = character:FindFirstChild("HumanoidRootPart")
                if root then
                    -- Tìm trứng xịn nhất
                    local bestEgg = findBestEgg()
                    
                    if bestEgg then
                        print("[BTMod] Đang farm trứng: " .. bestEgg.Name)
                        
                        -- Tween đến trứng
                        tweenToEgg(bestEgg)
                        
                        -- Đợi một chút
                        wait(0.2)
                        
                        -- Tìm trứng khác
                        bestEgg = findBestEgg()
                        if bestEgg then
                            tweenToEgg(bestEgg)
                        end
                    else
                        print("[BTMod] Không tìm thấy trứng!")
                        wait(1)
                    end
                end
            end
            wait(0.1)
        end
    end)
end

