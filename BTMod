-- [[ TZUY HUB - SIÊU AN TOÀN KHÔNG BỊ KICK ]]
local Player = game:GetService("Players").LocalPlayer
local Character = Player.Character or Player.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

-- Chờ 5 giây để anti-cheat ổn định
task.wait(5)

-- Tăng tốc từ từ (không đột ngột)
for speed = 16, 40, 2 do
    Humanoid.WalkSpeed = speed
    task.wait(0.3)
end

-- Chống AFK nhẹ (không dùng VirtualUser nếu bị phát hiện)
Player.Idled:Connect(function()
    -- Thử dùng VirtualUser, nếu bị kick thì bỏ dòng này
    pcall(function()
        game:GetService("VirtualUser"):Button2Down(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        game:GetService("VirtualUser"):Button2Up(Vector2.new(0,0), workspace.CurrentCamera.CFrame)
    end)
end)

-- Tìm và nhặt trứng thủ công (không teleport, không firetouchinterest liên tục)
local function TryCollectEgg()
    local HRP = Character:FindFirstChild("HumanoidRootPart")
    if not HRP then return end
    
    local nearest = nil
    local minDist = 100
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name:lower():find("egg") then
            local dist = (HRP.Position - obj.Position).Magnitude
            if dist < minDist then
                minDist = dist
                nearest = obj
            end
        end
    end
    
    if nearest then
        Humanoid:MoveTo(nearest.Position)
        task.wait(2)
        -- Chỉ chạm 1 lần, không spam
        firetouchinterest(HRP, nearest, 0)
        firetouchinterest(HRP, nearest, 1)
        task.wait(1)
    end
end

-- Chạy thử 1 lần
TryCollectEgg()

print("Script an toàn đã chạy xong, không lặp lại.")
